{
    "name": "vue",
    "goal_type": "Web Frontend Application",
    "deliverables": [
        "package.json",
        "src/App.vue",
        "src/main.js",
        "index.html"
    ],
    "preconditions": [
        "node",
        "npm"
    ],
    "required_files": [
        "{project_dir}/package.json",
        "{project_dir}/src/App.vue",
        "{project_dir}/src/main.js",
        "{project_dir}/index.html"
    ],
    "required_directories": [
        "{project_dir}",
        "{project_dir}/src"
    ],
    "required_dependencies": [
        "vue"
    ],
    "risk_analysis": {},
    "phases": {
        "Project Setup": [
            {
                "description": "Create project directory",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}",
                "required_artifacts": [],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create_directory",
                        "path": "{project_dir}"
                    }
                }
            }
        ],
        "Environment Setup": [
            {
                "description": "Initialize npm package.json",
                "action_type": "command_execution",
                "required_skill": "system",
                "expected_artifact": "{project_dir}/package.json",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "command_execution",
                    "params": {
                        "command": [
                            "npm",
                            "init",
                            "-y"
                        ],
                        "cwd": "{project_dir}"
                    }
                }
            }
        ],
        "Dependency Installation": [
            {
                "description": "Install Vue package",
                "action_type": "command_execution",
                "required_skill": "system",
                "expected_artifact": "{project_dir}/node_modules/vue",
                "required_artifacts": [
                    "{project_dir}/package.json"
                ],
                "metadata": {
                    "action": "command_execution",
                    "params": {
                        "command": [
                            "npm",
                            "install",
                            "vue"
                        ],
                        "cwd": "{project_dir}"
                    }
                }
            }
        ],
        "Project Structure": [
            {
                "description": "Create src directory",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/src",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create_directory",
                        "path": "{project_dir}/src"
                    }
                }
            }
        ],
        "Source Code Generation": [
            {
                "description": "Generate Vue main.js entrypoint",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/src/main.js",
                "required_artifacts": [
                    "{project_dir}/src"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/src/main.js",
                        "content": "import { createApp } from 'vue';\nimport App from './App.vue';\ncreateApp(App).mount('#app');\n"
                    }
                }
            },
            {
                "description": "Generate Vue App component",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/src/App.vue",
                "required_artifacts": [
                    "{project_dir}/src"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/src/App.vue",
                        "content": "<template><h1>Hello from Vue!</h1></template>\n"
                    }
                }
            },
            {
                "description": "Generate index.html template",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/index.html",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/index.html",
                        "content": "<!DOCTYPE html><html><body><div id='app'></div><script type='module' src='/src/main.js'></script></body></html>"
                    }
                }
            }
        ],
        "Configuration": [
            {
                "description": "Generate README.md file",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/README.md",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/README.md",
                        "content": "# Vue App\n"
                    }
                }
            }
        ],
        "Validation": [
            {
                "description": "Verify Vue structure",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}_validated",
                "required_artifacts": [
                    "{project_dir}/package.json"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "list",
                        "path": "{project_dir}"
                    }
                }
            }
        ],
        "Execution": [
            {
                "description": "Run Vue development server",
                "action_type": "run_project",
                "required_skill": "system",
                "expected_artifact": "{project_dir}_running",
                "required_artifacts": [
                    "{project_dir}_validated"
                ],
                "metadata": {
                    "action": "run_project",
                    "params": {
                        "project": "{project_dir}"
                    }
                }
            }
        ],
        "Verification": [
            {
                "description": "Verify frontend is responding",
                "action_type": "chromium_action",
                "required_skill": "browser",
                "expected_artifact": "{project_dir}_verified",
                "required_artifacts": [
                    "{project_dir}_running"
                ],
                "metadata": {
                    "action": "chromium_action",
                    "params": {
                        "operation": "open",
                        "url": "http://127.0.0.1:5173"
                    }
                }
            }
        ]
    }
}