{
    "name": "express",
    "goal_type": "REST API",
    "deliverables": [
        "package.json",
        "app.js"
    ],
    "preconditions": [
        "node",
        "npm"
    ],
    "required_files": [
        "{project_dir}/package.json",
        "{project_dir}/app.js"
    ],
    "required_directories": [
        "{project_dir}"
    ],
    "required_dependencies": [
        "express"
    ],
    "risk_analysis": {},
    "phases": {
        "Project Setup": [
            {
                "description": "Create project directory",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}",
                "required_artifacts": [],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create_directory",
                        "path": "{project_dir}"
                    }
                }
            }
        ],
        "Environment Setup": [
            {
                "description": "Initialize npm package.json",
                "action_type": "command_execution",
                "required_skill": "system",
                "expected_artifact": "{project_dir}/package.json",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "command_execution",
                    "params": {
                        "command": [
                            "npm",
                            "init",
                            "-y"
                        ],
                        "cwd": "{project_dir}"
                    }
                }
            }
        ],
        "Dependency Installation": [
            {
                "description": "Install Express package",
                "action_type": "command_execution",
                "required_skill": "system",
                "expected_artifact": "{project_dir}/node_modules/express",
                "required_artifacts": [
                    "{project_dir}/package.json"
                ],
                "metadata": {
                    "action": "command_execution",
                    "params": {
                        "command": [
                            "npm",
                            "install",
                            "express"
                        ],
                        "cwd": "{project_dir}"
                    }
                }
            }
        ],
        "Project Structure": [],
        "Source Code Generation": [
            {
                "description": "Generate Express app.js application file",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/app.js",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/app.js",
                        "content": "const express = require('express');\nconst app = express();\napp.get('/', (req, res) => res.send('Hello from Express!'));\napp.listen(3000);\n"
                    }
                }
            }
        ],
        "Configuration": [
            {
                "description": "Generate README.md file",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/README.md",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/README.md",
                        "content": "# Express App\n"
                    }
                }
            }
        ],
        "Validation": [
            {
                "description": "Verify Express structure",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}_validated",
                "required_artifacts": [
                    "{project_dir}/package.json"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "list",
                        "path": "{project_dir}"
                    }
                }
            }
        ],
        "Execution": [
            {
                "description": "Run Express development server",
                "action_type": "run_project",
                "required_skill": "system",
                "expected_artifact": "{project_dir}_running",
                "required_artifacts": [
                    "{project_dir}_validated"
                ],
                "metadata": {
                    "action": "run_project",
                    "params": {
                        "project": "{project_dir}"
                    }
                }
            }
        ],
        "Verification": [
            {
                "description": "Verify server is responding",
                "action_type": "chromium_action",
                "required_skill": "browser",
                "expected_artifact": "{project_dir}_verified",
                "required_artifacts": [
                    "{project_dir}_running"
                ],
                "metadata": {
                    "action": "chromium_action",
                    "params": {
                        "operation": "open",
                        "url": "http://127.0.0.1:3000"
                    }
                }
            }
        ]
    }
}