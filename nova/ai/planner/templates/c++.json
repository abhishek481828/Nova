{
    "name": "c++",
    "goal_type": "Systems Programming",
    "deliverables": [
        "main.cpp",
        "CMakeLists.txt",
        "README.md"
    ],
    "preconditions": [
        "g++",
        "make"
    ],
    "required_files": [
        "{project_dir}/main.cpp",
        "{project_dir}/CMakeLists.txt"
    ],
    "required_directories": [
        "{project_dir}"
    ],
    "required_dependencies": [],
    "risk_analysis": {
        "Missing compiler tools": "Install g++ compiler via nix"
    },
    "phases": {
        "Project Setup": [
            {
                "description": "Create project directory",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}",
                "required_artifacts": [],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create_directory",
                        "path": "{project_dir}"
                    }
                }
            }
        ],
        "Environment Setup": [
            {
                "description": "Initialize build environment",
                "action_type": "command_execution",
                "required_skill": "system",
                "expected_artifact": "{project_dir}_cpp_env",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "command_execution",
                    "params": {
                        "command": [
                            "g++",
                            "--version"
                        ]
                    }
                }
            }
        ],
        "Dependency Installation": [
            {
                "description": "Check compilation libraries",
                "action_type": "command_execution",
                "required_skill": "system",
                "expected_artifact": "{project_dir}_cpp_libs",
                "required_artifacts": [
                    "{project_dir}_cpp_env"
                ],
                "metadata": {
                    "action": "command_execution",
                    "params": {
                        "command": [
                            "echo",
                            "C++ compiler available"
                        ]
                    }
                }
            }
        ],
        "Project Structure": [],
        "Source Code Generation": [
            {
                "description": "Generate main.cpp source file",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/main.cpp",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/main.cpp",
                        "content": "#include <iostream>\nint main() {\n    std::cout << \"Hello from C++!\" << std::endl;\n    return 0;\n}\n"
                    }
                }
            }
        ],
        "Configuration": [
            {
                "description": "Generate CMakeLists.txt build file",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/CMakeLists.txt",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/CMakeLists.txt",
                        "content": "cmake_minimum_required(VERSION 3.10)\nproject(CppProject)\nadd_executable(main main.cpp)\n"
                    }
                }
            },
            {
                "description": "Generate README.md file",
                "action_type": "file_action",
                "required_skill": "files",
                "expected_artifact": "{project_dir}/README.md",
                "required_artifacts": [
                    "{project_dir}"
                ],
                "metadata": {
                    "action": "file_action",
                    "params": {
                        "operation": "create",
                        "path": "{project_dir}/README.md",
                        "content": "# C++ Project\n"
                    }
                }
            }
        ],
        "Validation": [
            {
                "description": "Compile C++ project",
                "action_type": "command_execution",
                "required_skill": "system",
                "expected_artifact": "{project_dir}/main",
                "required_artifacts": [
                    "{project_dir}/main.cpp"
                ],
                "metadata": {
                    "action": "command_execution",
                    "params": {
                        "command": [
                            "g++",
                            "-std=c++17",
                            "main.cpp",
                            "-o",
                            "main"
                        ],
                        "cwd": "{project_dir}"
                    }
                }
            }
        ],
        "Execution": [
            {
                "description": "Run C++ binary",
                "action_type": "run_project",
                "required_skill": "system",
                "expected_artifact": "{project_dir}_running",
                "required_artifacts": [
                    "{project_dir}/main"
                ],
                "metadata": {
                    "action": "run_project",
                    "params": {
                        "project": "{project_dir}"
                    }
                }
            }
        ],
        "Verification": [
            {
                "description": "Verify binary execution",
                "action_type": "command_execution",
                "required_skill": "system",
                "expected_artifact": "{project_dir}_verified",
                "required_artifacts": [
                    "{project_dir}_running"
                ],
                "metadata": {
                    "action": "command_execution",
                    "params": {
                        "command": [
                            "./main"
                        ],
                        "cwd": "{project_dir}"
                    }
                }
            }
        ]
    }
}